# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Supabase secret key. Server-only: never add NEXT_PUBLIC_ to this name.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY

# Canonical production address used for metadata and social previews.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional: only needed if password-protected portfolio routes are enabled.
PAGE_ACCESS_PASSWORD=

# Optional allowlist used by the metadata/image proxy, comma-separated.
OG_FETCH_ALLOWED_HOSTS=
